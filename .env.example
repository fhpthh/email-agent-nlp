# Application Settings
APP_NAME=Email Brief Agent
ENV=development
DEBUG=True

# Database Settings (Host port 5434)
DATABASE_URL=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Ingestion & Polling Parameters (No hardcoding)
INGESTION_BATCH_SIZE=50
SYNC_OVERLAP_MINUTES=10
THREAD_DEBOUNCE_SECONDS=180
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

# Provider Selection: "fake" | "gmail" | "outlook"
ACTIVE_EMAIL_PROVIDER=gmail
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# AI & LLM Settings
LLM_PROVIDER=litellm
LITELLM_BASE_URL
LITELLM_API_KEY
LITELLM_MODEL=gemini/gemini-3.8-flash

# Embedding & Vector
EMBEDDING_PROVIDER=litellm
EMBEDDING_MODEL_NAME=gemini/gemini-embedding-001
VECTOR_DIMENSION=768
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.65

