# Application Settings
APP_NAME=Email Brief Agent
ENV=development
DEBUG=True

# Database Settings (Host port 5434)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5434/email_agent_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Ingestion & Polling Parameters (No hardcoding)
INGESTION_BATCH_SIZE=50
SYNC_OVERLAP_MINUTES=10
THREAD_DEBOUNCE_SECONDS=180
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

# Provider Selection: "fake" | "gmail" | "outlook"
ACTIVE_EMAIL_PROVIDER=fake

# AI & LLM Settings
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MODEL_NAME=gemini-2.0-flash
VECTOR_DIMENSION=768